{
  "name": "Ocaml",
  "displayName": "OCaml",
  "options": "(?n)",
  "patterns": [
    {
      "name": "com",
      "type": "regex",
      "expressions": [
        "(?m:\\(\\*.*?\\*\\))"
      ]
    },
    {
      "name": "str",
      "type": "regex",
      "expressions": [
        "\"([^\"]|\\\\\")*\"",
        "'[^']*'"
      ]
    },
    {
      "name": "kw",
      "type": "keyword",
      "prefix": "WordBoundary",
      "postfix": "WordBoundary",
      "keywords": [
        "and", "as", "asr", "assert", "begin", "class", "constraints", "do", "done",
        "downto", "else", "end", "exception", "external", "false", "for", "fun",
        "function", "functor", "if", "in", "include", "inherit", "initializer",
        "land", "lazy", "let", "lor", "lsl", "lsr", "lxor", "match", "method", "mod",
        "module", "mutable", "new", "nonrec", "object", "of", "open", "or", "private",
        "rec", "sig", "struct", "then", "to", "true", "try", "type", "val", "virtual",
        "when", "while", "with"
      ]
    }
  ]
}