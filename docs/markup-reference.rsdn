[h1]Справочник по языку разметки RSDN Formatter[/h1]

[h2]Краткая справочная таблица[/h2]

[h3]Теги форматирования[/h3]

[t]
[tr]
[th]Категория[/th]
[th]Тег[/th]
[th]Описание[/th]
[/tr]
[tr]
[td][b]Форматирование текста[/b][/td]
[td][c]&#91;b]...&#91;/b][/c][/td]
[td][b]Жирный текст[/b][/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;i]...&#91;/i][/c][/td]
[td][i]Курсив[/i][/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;u]...&#91;/u][/c][/td]
[td][u]Подчёркнутый текст[/u][/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;s]...&#91;/s][/c][/td]
[td][s]Зачёркнутый текст[/s][/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;sub]...&#91;/sub][/c][/td]
[td]Подстрочный индекс (H[sub]2[/sub]O)[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;sup]...&#91;/sup][/c][/td]
[td]Надстрочный индекс (E=mc[sup]2[/sup])[/td]
[/tr]
[tr]
[td][b]Ссылки[/b][/td]
[td][c]&#91;url]URL&#91;/url][/c][/td]
[td]Ссылка[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;url=URL]текст&#91;/url][/c][/td]
[td]Ссылка с текстом[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;email]email&#91;/email][/c][/td]
[td]Email-ссылка[/td]
[/tr]
[tr]
[td][b]Изображения[/b][/td]
[td][c]&#91;img]URL&#91;/img][/c][/td]
[td]Изображение[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;img=small]URL&#91;/img][/c][/td]
[td]Маленькое изображение[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;img=large]URL&#91;/img][/c][/td]
[td]Большое изображение[/td]
[/tr]
[tr]
[td][b]Цитирование[/b][/td]
[td][c]&#91;quote]...&#91;/quote][/c][/td]
[td]Блочная цитата[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;quote=автор]...&#91;/quote][/c][/td]
[td]Цитата с указанием автора[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;q]...&#91;/q][/c][/td]
[td]Inline-цитата[/td]
[/tr]
[tr]
[td][/td]
[td][c]A> текст[/c][/td]
[td]Префикс цитирования (одиночный)[/td]
[/tr]
[tr]
[td][/td]
[td][c]B>> текст[/c][/td]
[td]Префикс цитирования (вложенный)[/td]
[/tr]
[tr]
[td][b]Структура[/b][/td]
[td][c]&#91;cut]...&#91;/cut][/c][/td]
[td]Скрытый текст (спойлер)[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;cut=заголовок]...&#91;/cut][/c][/td]
[td]Спойлер с заголовком[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;hr][/c][/td]
[td]Горизонтальная линия[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;h1]...&#91;/h1][/c] – [c]&#91;h6]...&#91;/h6][/c][/td]
[td]Заголовки 1–6 уровня[/td]
[/tr]
[tr]
[td][b]Списки[/b][/td]
[td][c]&#91;list]&#91;*]пункт...&#91;/list][/c][/td]
[td]Маркированный список[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;list=1]&#91;*]пункт...&#91;/list][/c][/td]
[td]Нумерованный (арабские цифры)[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;list=a]&#91;*]пункт...&#91;/list][/c][/td]
[td]Нумерованный (строчные буквы)[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;list=A]&#91;*]пункт...&#91;/list][/c][/td]
[td]Нумерованный (прописные буквы)[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;list=i]&#91;*]пункт...&#91;/list][/c][/td]
[td]Нумерованный (римские цифры)[/td]
[/tr]
[tr]
[td][b]Таблицы[/b][/td]
[td][c]&#91;t]&#91;tr]&#91;td]...&#91;/td]&#91;/tr]&#91;/t][/c][/td]
[td]Таблица[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;th]...&#91;/th][/c][/td]
[td]Ячейка заголовка таблицы[/td]
[/tr]
[tr]
[td][b]Код[/b][/td]
[td][c]&#91;code]...&#91;/code][/c][/td]
[td]Блок кода без подсветки[/td]
[/tr]
[tr]
[td][/td]
[td][c]&#91;code=язык]...&#91;/code][/c][/td]
[td]Блок кода с подсветкой[/td]
[/tr]
[/t]

