{
  "name": "C",
  "displayName": "C/C++",
  "options": "(?n)",
  "patterns": [
    {
      "name": "com",
      "type": "regex",
      "expressions": [
        "(?m://.*?$)",
        "(?s:/\\*.*?\\*/)"
      ]
    },
    {
      "name": "str",
      "type": "regex",
      "expressions": [
        "'([^'\\\\]|\\\\['\"\\\\0abfnrtv]|\\\\x[0-9aAbBcCdDeEfF]{1,4})'",
        "(?<!@)\"((?<!\\\\)\\\\\"|[^\"])*\"",
        "@\"(\"\"|[^\"])*\""
      ]
    },
    {
      "name": "kw",
      "type": "keyword",
      "prefix": "#\\s*",
      "postfix": "\\b",
      "keywords": [
        "define", "elif", "else", "endif", "error", "if", "ifdef", "ifndef",
        "import", "include", "line", "pragma", "undef"
      ]
    },
    {
      "name": "kw",
      "type": "keyword",
      "prefix": "\\b",
      "postfix": "\\b",
      "keywords": [
        "__abstract", "__asm", "__based", "__box", "__cdecl", "__declspec", "__delegate",
        "__event", "__except", "__fastcall", "__finally", "__gc", "__identifier", "__inline",
        "__int16", "__int32", "__int64", "__int8", "__interface", "__leave",
        "__multiple_inheritance", "__nogc", "__pin", "__property", "__sealed",
        "__single_inheritance", "__stdcall", "__try", "__try_cast", "__typeof", "__uuidof",
        "__value", "__virtual_inheritance",
        "asm", "auto", "bad_cast", "bad_typeid", "bool", "break", "case", "catch", "char",
        "class", "const", "const_cast", "continue", "default", "delete", "do", "double",
        "dynamic_cast", "else", "enum", "except", "explicit", "extern", "false", "finally",
        "float", "for", "friend", "goto", "if", "inline", "int", "long", "mutable",
        "namespace", "new", "operator", "private", "protected", "public", "register",
        "reinterpret_cast", "return", "short", "signed", "sizeof", "static", "static_cast",
        "struct", "switch", "template", "this", "throw", "true", "try", "type_info",
        "typedef", "typeid", "typename", "union", "unsigned", "using", "virtual", "void",
        "volatile", "wchar", "wchar_t", "while"
      ]
    }
  ]
}