{
  "name": "ObjC",
  "displayName": "Objective-C",
  "options": "(?n)",
  "patterns": [
    {
      "name": "com",
      "type": "regex",
      "expressions": [
        "(?m://.*?$)",
        "(?s:/\\*.*?\\*/)"
      ]
    },
    {
      "name": "str",
      "type": "regex",
      "expressions": [
        "\"([^\"]|\\\\\")*\"",
        "'([^']|\\\\')*'"
      ]
    },
    {
      "name": "kw",
      "type": "keyword",
      "prefix": "WordBoundary",
      "postfix": "WordBoundary",
      "keywords": [
        "auto", "break", "case", "char", "const", "continue", "default", "do",
        "double", "else", "enum", "extern", "float", "for", "goto", "if", "inline",
        "int", "long", "register", "restrict", "return", "short", "signed", "sizeof",
        "static", "struct", "switch", "typedef", "union", "unsigned", "void",
        "volatile", "while", "_Bool", "_Complex", "_Imaginary",
        "BOOL", "Class", "IMP", "id", "nil", "Nil", "NO", "NULL", "SEL", "self",
        "super", "YES", "@class", "@defs", "@encode", "@end", "@implementation",
        "@interface", "@private", "@protected", "@public", "@protocol", "@selector",
        "@synchronized", "@throw", "@try", "@catch", "@finally", "@property",
        "@synthesize", "@dynamic", "@optional", "@required", "@import",
        "assign", "copy", "getter", "nonatomic", "readonly", "readwrite", "retain",
        "setter", "strong", "unsafe_unretained", "weak", "atomic"
      ]
    }
  ]
}